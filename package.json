{
  "name": "nostromo-pwa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest",
    "test:coverage": "jest --coverage",
    "lighthouse": "lhci autorun --upload.outputDir=rapports-lighthouse/telephone && lhci autorun --collect.settings.preset=desktop --upload.outputDir=rapports-lighthouse/ordinateur",
    "test:e2e": "playwright test",
    "fiches": "node scripts/fiches.mjs"
  },
  "dependencies": {
    "@fontsource/questrial": "5.3.0",
    "@preact/signals": "2.11.3",
    "preact": "11.0.1",
    "preact-iso": "2.12.2",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@swc/core": "1.16.18",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "pdf-lib": "1.17.1",
    "sass": "1.105.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0"
  }
}
